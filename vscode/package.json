{
  "name": "norn",
  "displayName": "Norn",
  "description": "Norn: Source-Insight-style symbol search, context and relation views for C, from an index that follows macros and function pointers.",
  "version": "0.21.1",
  "publisher": "humphrey0925",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/humphrey0925/norn.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:c",
    "onLanguage:cpp",
    "workspaceContains:**/*.c",
    "workspaceContains:**/*.cpp",
    "workspaceContains:**/*.cc"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "si",
          "title": "Norn",
          "icon": "media/norn.svg"
        }
      ],
      "panel": [
        {
          "id": "siPanel",
          "title": "Norn",
          "icon": "media/norn.svg"
        }
      ]
    },
    "views": {
      "si": [
        {
          "type": "webview",
          "id": "norn.search",
          "name": "Project Symbols",
          "contextualTitle": "Norn Symbols"
        },
        {
          "id": "norn.fileSymbols",
          "name": "File Symbols",
          "contextualTitle": "Norn File Symbols"
        },
        {
          "id": "norn.scope",
          "name": "Index Scope",
          "contextualTitle": "Norn Index Scope"
        },
        {
          "id": "norn.conditions",
          "name": "Compile Conditions",
          "contextualTitle": "Norn Compile Conditions",
          "visibility": "collapsed"
        }
      ],
      "siPanel": [
        {
          "id": "norn.relation",
          "name": "Relation",
          "type": "webview",
          "contextualTitle": "Norn Relation"
        },
        {
          "type": "webview",
          "id": "norn.context",
          "name": "Context",
          "contextualTitle": "Norn Context"
        }
      ]
    },
    "commands": [
      {
        "command": "norn.search.ask",
        "title": "Norn: Search Symbols…"
      },
      {
        "command": "norn.relation.callers",
        "title": "Norn: Show Callers",
        "icon": "$(call-incoming)"
      },
      {
        "command": "norn.relation.callees",
        "title": "Norn: Show Calls",
        "icon": "$(call-outgoing)"
      },
      {
        "command": "norn.relation.references",
        "title": "Norn: Show References",
        "icon": "$(references)"
      },
      {
        "command": "norn.relation.lock",
        "title": "Norn: Lock Relation (stop following the cursor)",
        "icon": "$(unlock)"
      },
      {
        "command": "norn.relation.unlock",
        "title": "Norn: Unlock Relation",
        "icon": "$(lock)"
      },
      {
        "command": "norn.context.lock",
        "title": "Norn: Lock Context (stop following the cursor)",
        "icon": "$(unlock)"
      },
      {
        "command": "norn.context.unlock",
        "title": "Norn: Unlock Context",
        "icon": "$(lock)"
      },
      {
        "command": "norn.openToSide",
        "title": "Open to the Side",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "norn.restart",
        "title": "Norn: Restart Index (parse only what changed)"
      },
      {
        "command": "norn.relation.tree",
        "title": "Norn: Show Relation as a Tree"
      },
      {
        "command": "norn.relation.graph",
        "title": "Norn: Show Relation as a Graph"
      },
      {
        "command": "norn.rebuild",
        "title": "Norn: Discard the Saved Index and Rebuild",
        "icon": "$(debug-restart)"
      },
      {
        "command": "norn.sync",
        "title": "Norn: Sync Index with Disk",
        "icon": "$(sync)"
      },
      {
        "command": "norn.scope.include",
        "title": "Norn: Index This Folder"
      },
      {
        "command": "norn.scope.exclude",
        "title": "Norn: Exclude This Folder from the Index"
      },
      {
        "command": "norn.scope.only",
        "title": "Norn: Index Only This Folder"
      },
      {
        "command": "norn.scope.openConfig",
        "title": "Norn: Open the Scope File (.norn/config.json)",
        "icon": "$(go-to-file)"
      },
      {
        "command": "norn.scope.apply",
        "title": "Norn: Apply the Scope and Index",
        "icon": "$(check)"
      },
      {
        "command": "norn.scope.discard",
        "title": "Norn: Discard Unapplied Scope Changes",
        "icon": "$(discard)"
      },
      {
        "command": "norn.scope.selectAll",
        "title": "Norn: Check All Folders",
        "icon": "$(check-all)"
      },
      {
        "command": "norn.scope.clearAll",
        "title": "Norn: Uncheck All Folders",
        "icon": "$(clear-all)"
      },
      {
        "command": "norn.resetLayout",
        "title": "Norn: Reset View Layout (put every Norn view back in place)"
      },
      {
        "command": "norn.scope.all",
        "title": "Norn: Index the Whole Workspace"
      },
      {
        "command": "norn.relation.assignments",
        "title": "Norn: Show Function Pointer Assignments"
      },
      {
        "command": "norn.conditions.add",
        "title": "Norn: Add a Compile Condition…",
        "icon": "$(add)"
      },
      {
        "command": "norn.conditions.switch",
        "title": "Norn: Switch Compile Configuration…",
        "icon": "$(list-selection)"
      },
      {
        "command": "norn.conditions.define",
        "title": "Norn: Define a Macro for Conditions…",
        "icon": "$(add)"
      },
      {
        "command": "norn.conditions.undefine",
        "title": "Norn: Mark a Macro as Not Defined…",
        "icon": "$(circle-slash)"
      },
      {
        "command": "norn.conditions.addFile",
        "title": "Norn: Read Conditions from a File (.config, header)…",
        "icon": "$(file-add)"
      },
      {
        "command": "norn.conditions.assume",
        "title": "Norn: Assume Names Are Not Defined (prefix or *)…",
        "icon": "$(question)"
      },
      {
        "command": "norn.conditions.remove",
        "title": "Remove",
        "icon": "$(trash)"
      },
      {
        "command": "norn.conditions.override",
        "title": "Set Another Value Here",
        "icon": "$(edit)"
      },
      {
        "command": "norn.conditions.delete",
        "title": "Delete Configuration"
      },
      {
        "command": "norn.relation.sync",
        "title": "Norn: Show Relation of the Symbol under the Cursor",
        "icon": "$(target)"
      },
      {
        "command": "norn.context.sync",
        "title": "Norn: Show Context of the Symbol under the Cursor",
        "icon": "$(target)"
      },
      {
        "command": "norn.relation.target",
        "title": "Norn: Relation target"
      },
      {
        "command": "norn.conditions.toCpp",
        "title": "Norn: Write Compile Conditions to the C/C++ Extension (c_cpp_properties.json)",
        "icon": "$(export)"
      },
      {
        "command": "norn.context.shown",
        "title": "Norn: Context shown"
      },
      {
        "command": "norn.serverInUse",
        "title": "Norn: Server in use"
      },
      {
        "command": "norn.conditions.sourcesOff",
        "title": "Do Not Use the Sources' Own #defines",
        "icon": "$(eye-closed)"
      },
      {
        "command": "norn.conditions.sourcesOn",
        "title": "Use the Sources' Own #defines",
        "icon": "$(eye)"
      },
      {
        "command": "norn.fileSymbols.tree",
        "title": "Norn: File Symbols tree"
      },
      {
        "command": "norn.goToDefinition",
        "title": "Norn: Go to Definition"
      },
      {
        "command": "norn.goToImplementations",
        "title": "Norn: Go to Implementations"
      },
      {
        "command": "norn.goToReferences",
        "title": "Norn: Go to References"
      },
      {
        "command": "norn.switchHeaderSource",
        "title": "Norn: Switch Header/Source"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "norn.relation.lock",
          "when": "view == norn.relation && !norn.relationLocked",
          "group": "navigation@4"
        },
        {
          "command": "norn.relation.unlock",
          "when": "view == norn.relation && norn.relationLocked",
          "group": "navigation@4"
        },
        {
          "command": "norn.context.lock",
          "when": "view == norn.context && !norn.contextLocked",
          "group": "navigation@1"
        },
        {
          "command": "norn.context.unlock",
          "when": "view == norn.context && norn.contextLocked",
          "group": "navigation@1"
        },
        {
          "command": "norn.sync",
          "when": "view == norn.search || view == norn.fileSymbols",
          "group": "navigation@1"
        },
        {
          "command": "norn.scope.apply",
          "when": "view == norn.scope && norn.scopePending",
          "group": "navigation@1"
        },
        {
          "command": "norn.scope.discard",
          "when": "view == norn.scope && norn.scopePending",
          "group": "navigation@2"
        },
        {
          "command": "norn.scope.selectAll",
          "when": "view == norn.scope",
          "group": "navigation@3"
        },
        {
          "command": "norn.scope.clearAll",
          "when": "view == norn.scope",
          "group": "navigation@4"
        },
        {
          "command": "norn.sync",
          "when": "view == norn.scope",
          "group": "navigation@5"
        },
        {
          "command": "norn.scope.openConfig",
          "when": "view == norn.scope",
          "group": "1_si@1"
        },
        {
          "command": "norn.rebuild",
          "when": "view == norn.scope",
          "group": "1_si@2"
        },
        {
          "command": "norn.resetLayout",
          "when": "view =~ /^si\\\\./",
          "group": "9_si@1"
        },
        {
          "command": "norn.conditions.add",
          "when": "view == norn.conditions",
          "group": "navigation@1"
        },
        {
          "command": "norn.conditions.switch",
          "when": "view == norn.conditions",
          "group": "navigation@2"
        },
        {
          "command": "norn.scope.openConfig",
          "when": "view == norn.conditions",
          "group": "1_si@1"
        },
        {
          "command": "norn.relation.sync",
          "when": "view == norn.relation",
          "group": "navigation@3"
        },
        {
          "command": "norn.context.sync",
          "when": "view == norn.context",
          "group": "navigation@0"
        },
        {
          "command": "norn.conditions.toCpp",
          "when": "view == norn.conditions",
          "group": "1_si@2"
        }
      ],
      "view/item/context": [
        {
          "command": "norn.openToSide",
          "when": "view == norn.fileSymbols",
          "group": "inline@1"
        },
        {
          "command": "norn.scope.only",
          "when": "view == norn.scope && viewItem == folder",
          "group": "si@1"
        },
        {
          "command": "norn.scope.include",
          "when": "view == norn.scope && viewItem == folder",
          "group": "si@2"
        },
        {
          "command": "norn.scope.exclude",
          "when": "view == norn.scope && viewItem == folder",
          "group": "si@3"
        },
        {
          "command": "norn.conditions.remove",
          "when": "view == norn.conditions && viewItem =~ /^(condition|source.file|assume)$/",
          "group": "inline@1"
        },
        {
          "command": "norn.conditions.override",
          "when": "view == norn.conditions && viewItem == condition.from",
          "group": "inline@1"
        },
        {
          "command": "norn.conditions.add",
          "when": "view == norn.conditions && viewItem == source.own",
          "group": "inline@1"
        },
        {
          "command": "norn.conditions.switch",
          "when": "view == norn.conditions && viewItem == config",
          "group": "inline@1"
        },
        {
          "command": "norn.conditions.sourcesOff",
          "when": "view == norn.conditions && viewItem == sources.on",
          "group": "inline@1"
        },
        {
          "command": "norn.conditions.sourcesOn",
          "when": "view == norn.conditions && viewItem == sources.off",
          "group": "inline@1"
        }
      ],
      "commandPalette": [
        {
          "command": "norn.openToSide",
          "when": "false"
        },
        {
          "command": "norn.scope.include",
          "when": "false"
        },
        {
          "command": "norn.scope.exclude",
          "when": "false"
        },
        {
          "command": "norn.scope.only",
          "when": "false"
        },
        {
          "command": "norn.conditions.remove",
          "when": "false"
        },
        {
          "command": "norn.conditions.override",
          "when": "false"
        },
        {
          "command": "norn.conditions.delete",
          "when": "false"
        },
        {
          "command": "norn.relation.target",
          "when": "false"
        },
        {
          "command": "norn.context.shown",
          "when": "false"
        },
        {
          "command": "norn.serverInUse",
          "when": "false"
        },
        {
          "command": "norn.conditions.sourcesOff",
          "when": "false"
        },
        {
          "command": "norn.conditions.sourcesOn",
          "when": "false"
        },
        {
          "command": "norn.fileSymbols.tree",
          "when": "false"
        },
        {
          "command": "norn.goToDefinition",
          "when": "editorLangId =~ /^(c|cpp)$/"
        },
        {
          "command": "norn.goToImplementations",
          "when": "editorLangId =~ /^(c|cpp)$/"
        },
        {
          "command": "norn.goToReferences",
          "when": "editorLangId =~ /^(c|cpp)$/"
        }
      ],
      "explorer/context": [
        {
          "command": "norn.scope.include",
          "when": "explorerResourceIsFolder",
          "group": "si@1"
        },
        {
          "command": "norn.scope.exclude",
          "when": "explorerResourceIsFolder",
          "group": "si@2"
        },
        {
          "command": "norn.scope.only",
          "when": "explorerResourceIsFolder",
          "group": "si@3"
        }
      ],
      "editor/context": [
        {
          "command": "norn.goToDefinition",
          "when": "editorLangId =~ /^(c|cpp)$/",
          "group": "navigation@0.1"
        },
        {
          "command": "norn.goToImplementations",
          "when": "editorLangId =~ /^(c|cpp)$/",
          "group": "navigation@0.2"
        },
        {
          "command": "norn.goToReferences",
          "when": "editorLangId =~ /^(c|cpp)$/",
          "group": "navigation@0.3"
        }
      ]
    },
    "configuration": {
      "title": "Norn",
      "properties": {
        "norn.dimInactive": {
          "type": "string",
          "enum": ["auto", "always", "never"],
          "enumDescriptions": [
            "Dim them where the C/C++ extension does not (it is not installed, or its IntelliSense is off).",
            "Always dim them.",
            "Never dim them."
          ],
          "default": "auto",
          "description": "Dim the lines the compile conditions in force switch off (#if branches not compiled)."
        },
        "norn.serverPath": {
          "type": "string",
          "default": "",
          "description": "Leave empty to use the server that comes with the extension (Windows x64), or norn on PATH where there is none. Set it to the full path of another norn executable to use that instead, for example D:\\tools\\norn-windows-x64.exe (no quotes needed)."
        },
        "norn.includeAliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Which template a generated header comes from, as FROM=TO, for example bfd.h=bfd-in2.h."
        },
        "norn.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the number of callers and calls above each function definition."
        },
        "norn.cache.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Keep the index on disk, so that the next start parses only the files that changed."
        },
        "norn.cache.directory": {
          "type": "string",
          "default": "",
          "description": "Where the index is kept. Empty: .norn/cache in the workspace."
        },
        "norn.conditions.updateCppProperties": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Keep a configuration named \"Norn\" in .vscode/c_cpp_properties.json in step with the compile configuration in force: its defines and, from a DS-5 / Eclipse .cproject, its include paths. Select that configuration in the C/C++ extension to use it."
        },
        "norn.fileSymbols.showLocals": {
          "type": "boolean",
          "default": true,
          "description": "In File Symbols, list each function's parameters and local variables under it."
        }
      }
    },
    "keybindings": [
      {
        "command": "norn.goToDefinition",
        "key": "f12",
        "when": "editorTextFocus && editorLangId =~ /^(c|cpp)$/"
      },
      {
        "command": "norn.goToImplementations",
        "key": "ctrl+f12",
        "when": "editorTextFocus && editorLangId =~ /^(c|cpp)$/"
      },
      {
        "command": "norn.goToReferences",
        "key": "shift+f12",
        "when": "editorTextFocus && editorLangId =~ /^(c|cpp)$/"
      },
      {
        "command": "norn.switchHeaderSource",
        "key": "alt+o",
        "when": "editorTextFocus && editorLangId =~ /^(c|cpp)$/ && !norn.cppTools"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./ && npm run bundle",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --target=node18 --format=cjs --external:vscode --main-fields=module,main --minify-whitespace --minify-syntax --outfile=out/extension.js --log-level=warning",
    "vscode:prepublish": "npm run compile",
    "watch": "tsc -watch -p ./",
    "package": "npx --yes @vscode/vsce package --allow-missing-repository --skip-license -o ../out/norn.vsix",
    "test": "npm run compile && node ./out/test/runTest.js",
    "test:package": "npm run compile && npm run package && node ./out/test/package.js && node ./out/test/runTest.js packaged"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.36",
    "jsonc-parser": "^3.3.1",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.4.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.4.0"
  }
}
