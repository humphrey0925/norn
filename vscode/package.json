{
  "name": "si-code-index",
  "displayName": "SI Code Index",
  "description": "Source-Insight-style symbol search, context and relation views for C, backed by the si index.",
  "version": "0.9.0",
  "publisher": "humphrey0925",
  "repository": {
    "type": "git",
    "url": "https://github.com/humphrey0925/si.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:c",
    "onLanguage:cpp",
    "workspaceContains:**/*.c"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "si",
          "title": "SI",
          "icon": "media/si.svg"
        }
      ],
      "panel": [
        {
          "id": "siPanel",
          "title": "SI",
          "icon": "media/si.svg"
        }
      ]
    },
    "views": {
      "si": [
        {
          "type": "webview",
          "id": "si.search",
          "name": "Project Symbols",
          "contextualTitle": "SI Symbols"
        },
        {
          "id": "si.fileSymbols",
          "name": "File Symbols",
          "contextualTitle": "SI File Symbols"
        },
        {
          "id": "si.scope",
          "name": "Index Scope",
          "contextualTitle": "SI Index Scope"
        },
        {
          "id": "si.conditions",
          "name": "Compile Conditions",
          "contextualTitle": "SI Compile Conditions",
          "visibility": "collapsed"
        }
      ],
      "siPanel": [
        {
          "id": "si.relation",
          "name": "Relation",
          "type": "webview",
          "contextualTitle": "SI Relation"
        },
        {
          "type": "webview",
          "id": "si.context",
          "name": "Context",
          "contextualTitle": "SI Context"
        }
      ]
    },
    "commands": [
      {
        "command": "si.relation.callers",
        "title": "SI: Show Callers",
        "icon": "$(call-incoming)"
      },
      {
        "command": "si.relation.callees",
        "title": "SI: Show Calls",
        "icon": "$(call-outgoing)"
      },
      {
        "command": "si.relation.references",
        "title": "SI: Show References",
        "icon": "$(references)"
      },
      {
        "command": "si.relation.lock",
        "title": "SI: Lock Relation (stop following the cursor)",
        "icon": "$(unlock)"
      },
      {
        "command": "si.relation.unlock",
        "title": "SI: Unlock Relation",
        "icon": "$(lock)"
      },
      {
        "command": "si.context.lock",
        "title": "SI: Lock Context (stop following the cursor)",
        "icon": "$(unlock)"
      },
      {
        "command": "si.context.unlock",
        "title": "SI: Unlock Context",
        "icon": "$(lock)"
      },
      {
        "command": "si.openToSide",
        "title": "Open to the Side",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "si.restart",
        "title": "SI: Restart Index (parse only what changed)"
      },
      {
        "command": "si.relation.tree",
        "title": "SI: Show Relation as a Tree"
      },
      {
        "command": "si.relation.graph",
        "title": "SI: Show Relation as a Graph"
      },
      {
        "command": "si.rebuild",
        "title": "SI: Discard the Saved Index and Rebuild",
        "icon": "$(debug-restart)"
      },
      {
        "command": "si.sync",
        "title": "SI: Sync Index with Disk",
        "icon": "$(sync)"
      },
      {
        "command": "si.scope.include",
        "title": "SI: Index This Folder"
      },
      {
        "command": "si.scope.exclude",
        "title": "SI: Exclude This Folder from the Index"
      },
      {
        "command": "si.scope.only",
        "title": "SI: Index Only This Folder"
      },
      {
        "command": "si.scope.openConfig",
        "title": "SI: Open the Scope File (.si/config.json)",
        "icon": "$(go-to-file)"
      },
      {
        "command": "si.scope.apply",
        "title": "SI: Apply the Scope and Index",
        "icon": "$(check)"
      },
      {
        "command": "si.scope.discard",
        "title": "SI: Discard Unapplied Scope Changes",
        "icon": "$(discard)"
      },
      {
        "command": "si.scope.selectAll",
        "title": "SI: Check All Folders",
        "icon": "$(check-all)"
      },
      {
        "command": "si.scope.clearAll",
        "title": "SI: Uncheck All Folders",
        "icon": "$(clear-all)"
      },
      {
        "command": "si.resetLayout",
        "title": "SI: Reset View Layout (put every SI view back in place)"
      },
      {
        "command": "si.scope.all",
        "title": "SI: Index the Whole Workspace"
      },
      {
        "command": "si.relation.assignments",
        "title": "SI: Show Function Pointer Assignments"
      },
      {
        "command": "si.conditions.define",
        "title": "SI: Define a Macro for Conditions…",
        "icon": "$(add)"
      },
      {
        "command": "si.conditions.undefine",
        "title": "SI: Mark a Macro as Not Defined…",
        "icon": "$(circle-slash)"
      },
      {
        "command": "si.conditions.addFile",
        "title": "SI: Read Conditions from a File (.config, header)…",
        "icon": "$(file-add)"
      },
      {
        "command": "si.conditions.assume",
        "title": "SI: Assume Names Are Not Defined (prefix or *)…",
        "icon": "$(question)"
      },
      {
        "command": "si.conditions.remove",
        "title": "Remove",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "si.relation.lock",
          "when": "view == si.relation && !si.relationLocked",
          "group": "navigation@4"
        },
        {
          "command": "si.relation.unlock",
          "when": "view == si.relation && si.relationLocked",
          "group": "navigation@4"
        },
        {
          "command": "si.context.lock",
          "when": "view == si.context && !si.contextLocked",
          "group": "navigation@1"
        },
        {
          "command": "si.context.unlock",
          "when": "view == si.context && si.contextLocked",
          "group": "navigation@1"
        },
        {
          "command": "si.sync",
          "when": "view == si.search || view == si.fileSymbols",
          "group": "navigation@1"
        },
        {
          "command": "si.scope.apply",
          "when": "view == si.scope && si.scopePending",
          "group": "navigation@1"
        },
        {
          "command": "si.scope.discard",
          "when": "view == si.scope && si.scopePending",
          "group": "navigation@2"
        },
        {
          "command": "si.scope.selectAll",
          "when": "view == si.scope",
          "group": "navigation@3"
        },
        {
          "command": "si.scope.clearAll",
          "when": "view == si.scope",
          "group": "navigation@4"
        },
        {
          "command": "si.sync",
          "when": "view == si.scope",
          "group": "navigation@5"
        },
        {
          "command": "si.scope.openConfig",
          "when": "view == si.scope",
          "group": "1_si@1"
        },
        {
          "command": "si.rebuild",
          "when": "view == si.scope",
          "group": "1_si@2"
        },
        {
          "command": "si.resetLayout",
          "when": "view =~ /^si\\\\./",
          "group": "9_si@1"
        },
        {
          "command": "si.conditions.define",
          "when": "view == si.conditions",
          "group": "navigation@1"
        },
        {
          "command": "si.conditions.undefine",
          "when": "view == si.conditions",
          "group": "navigation@2"
        },
        {
          "command": "si.conditions.addFile",
          "when": "view == si.conditions",
          "group": "navigation@3"
        },
        {
          "command": "si.conditions.assume",
          "when": "view == si.conditions",
          "group": "navigation@4"
        },
        {
          "command": "si.scope.openConfig",
          "when": "view == si.conditions",
          "group": "1_si@1"
        }
      ],
      "view/item/context": [
        {
          "command": "si.openToSide",
          "when": "view == si.fileSymbols",
          "group": "inline@1"
        },
        {
          "command": "si.scope.only",
          "when": "view == si.scope && viewItem == folder",
          "group": "si@1"
        },
        {
          "command": "si.scope.include",
          "when": "view == si.scope && viewItem == folder",
          "group": "si@2"
        },
        {
          "command": "si.scope.exclude",
          "when": "view == si.scope && viewItem == folder",
          "group": "si@3"
        },
        {
          "command": "si.conditions.remove",
          "when": "view == si.conditions && viewItem == condition",
          "group": "inline@1"
        },
        {
          "command": "si.conditions.define",
          "when": "view == si.conditions && viewItem == group.defines",
          "group": "inline@1"
        },
        {
          "command": "si.conditions.undefine",
          "when": "view == si.conditions && viewItem == group.undefines",
          "group": "inline@1"
        },
        {
          "command": "si.conditions.addFile",
          "when": "view == si.conditions && viewItem == group.conditionFiles",
          "group": "inline@1"
        },
        {
          "command": "si.conditions.assume",
          "when": "view == si.conditions && viewItem == group.assumeUndefined",
          "group": "inline@1"
        }
      ],
      "commandPalette": [
        {
          "command": "si.openToSide",
          "when": "false"
        },
        {
          "command": "si.scope.include",
          "when": "false"
        },
        {
          "command": "si.scope.exclude",
          "when": "false"
        },
        {
          "command": "si.scope.only",
          "when": "false"
        },
        {
          "command": "si.conditions.remove",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "si.scope.include",
          "when": "explorerResourceIsFolder",
          "group": "si@1"
        },
        {
          "command": "si.scope.exclude",
          "when": "explorerResourceIsFolder",
          "group": "si@2"
        },
        {
          "command": "si.scope.only",
          "when": "explorerResourceIsFolder",
          "group": "si@3"
        }
      ]
    },
    "configuration": {
      "title": "SI",
      "properties": {
        "si.serverPath": {
          "type": "string",
          "default": "si",
          "description": "Full path of the si executable, for example D:\\tools\\si-windows-x64.exe (no quotes needed). By default si is looked up on PATH."
        },
        "si.includeAliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Which template a generated header comes from, as FROM=TO, for example bfd.h=bfd-in2.h."
        },
        "si.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the number of callers and calls above each function definition."
        },
        "si.cache.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Keep the index on disk, so that the next start parses only the files that changed."
        },
        "si.cache.directory": {
          "type": "string",
          "default": "",
          "description": "Where the index is kept. Empty: .si/cache in the workspace."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --allow-missing-repository --skip-license -o ../out/si-code-index.vsix",
    "test": "tsc -p ./ && node ./out/test/runTest.js"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "@vscode/codicons": "^0.0.36"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0",
    "@vscode/test-electron": "^2.4.0"
  }
}